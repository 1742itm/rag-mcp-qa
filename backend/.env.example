# ============ 服务 ============
HOST=127.0.0.1
PORT=8000
# 允许跨域的前端地址（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============ LLM（兼容 OpenAI 接口）============
# DeepSeek:      LLM_BASE_URL=https://api.deepseek.com/v1   LLM_MODEL=deepseek-chat
# 通义千问:       LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
# 本地 Ollama:   LLM_BASE_URL=http://localhost:11434/v1     LLM_MODEL=qwen2.5   （API Key 可留空）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3

# ============ 向量化 ============
# sentence-transformers: 语义向量，首次运行会下载模型（可走下方镜像）
# hash:                  零依赖降级方案，完全离线
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 仅 hash 模式生效
EMBEDDING_DIM=512
# HuggingFace 镜像；如果不需要可置空
HF_ENDPOINT=https://hf-mirror.com

# ============ RAG 参数 ============
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4
# 检索相似度下限：低于该值的片段视为无关，直接丢弃（避免噪声被喂成幻觉）
# 0.45 为实测标定值，切换向量模型或语料后建议重新标定
MIN_SCORE=0.45
# 哈希降级模式（EMBEDDING_PROVIDER=hash）专用：哈希向量分数整体低约 0.25
MIN_SCORE_HASH=0.15
# 命中片段向前后各扩展的相邻段数：一道题的答案常被切成多段，扩展可补齐长答案（0 = 关闭）
CONTEXT_WINDOW=2
# 单次检索注入上下文的总片段上限（含扩展段）
MAX_CONTEXT_CHUNKS=12